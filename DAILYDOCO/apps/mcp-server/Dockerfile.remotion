# Dockerfile extension for Remotion support
# Add this to your existing Dockerfile or merge with your current configuration

# Install Chrome dependencies for Remotion
RUN apt-get update && apt-get install -y \
    chromium \
    chromium-sandbox \
    fonts-liberation \
    fonts-noto-color-emoji \
    libappindicator3-1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libxss1 \
    libxtst6 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Install TTS dependencies
RUN apt-get update && apt-get install -y \
    espeak \
    python3 \
    python3-pip \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install Python TTS libraries
RUN pip3 install --no-cache-dir \
    gTTS \
    pyttsx3 \
    TTS

# Set Chrome path for Remotion
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV CHROME_BIN=/usr/bin/chromium

# Create directories for video output and temp files
RUN mkdir -p /app/output/videos /app/temp/audio /app/temp/remotion

# Set permissions
RUN chmod -R 777 /app/output /app/temp